var b = runtime_command()["dir"] + "/data/"
var s = runtime_command()["dir"] + "/session/"
var f = b + "template.singkong"
var d = b + "product.html"
load(f)

var public = true
var products = {
    "cc": [
            "Cassava Chips",
            [
                ["012345", "Personal", 5, 40], 
                ["012346", "Family", 6, 50] 
            ]
    ],
    "fc": [
            "Frozen Cassava",
            [
                ["012347", "Personal", 7, 80], 
                ["012348", "Family", 8, 70] 
            ]
    ]
}

load_module("web")
var sess = session_file_get(s)

var redir = false
if (!public) {
    if (none_or(sess["user"], sess["session"])) {
        redirect_to("login.web")
    }
} else {
    if (none(sess)) {
        var sess = session_new()
        var redir = true
    }
}
if (none(sess["cart"])) {
    set(sess, "cart", uuid())
    set(sess, "cart_item", {})
    session_file_set(s, sess)    
}
if (redir) {
    cgi_header(
        header_session(sess) +
        header_location("product.web")
    )
}

var t = "Products"
var p = "product.web"
var c = "product"

if (request_method() == "GET") {
    cgi_header()
    var tb = [
        ["product.web?a=cart", "bi-cart", 
            [cart_count(), "bg-primary", "cartBadge"]
        ],
        ["#", "bi-download", 
            [random(5, 50), "bg-danger", "downloadBadge"]
        ],
        ["#", "bi-question-circle", []]
    ]
    var g = cgi_get()
    var a = ifnone(g["a"], "") 
    var n = @ 
    var v = {
        "a": a
    }
    if (a == "cart") {
        var t = "Cart"
    }
    var bc = [
        ["index.web", "Application"],
        ["product.web", t]
    ]
    var h = header(t, p, c, sess, bc, tb)
    println(h)
    println(template(read(d)))
    var h = footer(p)
    println(h)
    exit()
}

if (request_method() == "POST") {
    var p = cgi_post()
    var a = ifnone(p["a"], "") 
    var o = ifnone(p["product"], "") 
    var v = ifnone(p["variant"], "")
    var vn = trim(ifnone(p["name"], ""))
    var ve = trim(ifnone(p["email"], ""))
    var va = trim(ifnone(p["address"], ""))
    var vt = trim(ifnone(p["note"], ""))
    if (a == "add") {
        var av = product_get_avail(products, o, v)
        if (av < 1) {
            cgi_text("Sorry, this product is no longer available")
        }
        var ap = product_get_price(products, o, v)
        var res = ifnone(sess["cart_item"], {})
        var k = o + ":" + v
        var cur = res[k]
        if (none(cur)) {
            var cur = [1, ap, 1 * ap]
        } else {
            set(cur, 0, cur[0] + 1)
            set(cur, 1, ap)
            set(cur, 2, ap * cur[0])
        }
        set(res, k, cur)
        set(sess, "cart_item", res)
        session_file_set(s, sess)    
        cgi_text("OK:" + cart_count())
    }
    if (a == "remove") {
        var res = ifnone(sess["cart_item"], {})
        var k = o + ":" + v
        res - k
        set(sess, "cart_item", res)
        session_file_set(s, sess)    
        cgi_text("OK:" + cart_count())
    }
    if (a == "checkout") {
        if (none(sess["cart_item"])) {
            cgi_text("Your shopping cart is currently empty")
        }
        if (!isemail(ve)) {
            cgi_text("Please verify your email address")
        }
        if (none(vn)) {
            cgi_text("Please enter your name")
        }
        if (none(va)) {
            cgi_text("Please enter your shipping address")
        }
        var d = [
            sess["cart"],
            sess["cart_item"],
            @,
            vn,
            ve,
            va,
            vt
        ]
        var res = cart_checkout(d)
        if (none(res)) {
            cgi_text("Please try again")
        }
        set(sess, "cart_item", {})
        session_file_set(s, sess)    
        cgi_text("OK")
    }

    cgi_text("ERROR")
}
