var cart_checkout_info = fn() {
    return [
        "Please fill out the following checkout form"
    ]
}

var cart_data = fn(x) {
    var n = []
    var c = ifnone(sess["cart_item"], {})
    each(keys(c), fn(e, i) {
        var v = c[e]
        n + v[x]
    })
    return sum(n)
}

var cart_count = fn() {
    return cart_data(0)
}

var cart_total = fn() {
    return cart_data(2)
}

var product_get_data = fn(d, p, v) {
    var ret = ["", []]
    var x = d[p]
    if (!none(x)) {
        if (is_array_len(x, 2)) {
            set(ret, 0, x[0])
            each(x[1], fn(e, i) {
                if (e[0] == v) {
                    set(ret, 1, e) 
                }
            })
        }
    }
    return ret
}

var product_get_avail = fn(d, p, v) {
    var d = product_get_data(d, p, v)
    return ifnone(d[1][3], 0)
}

var product_get_price = fn(d, p, v) {
    var d = product_get_data(d, p, v)
    return ifnone(d[1][2], 0)
}

var cart_checkout = fn(d) {
    return d
}
