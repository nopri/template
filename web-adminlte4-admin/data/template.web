var resource_account = [
    ["settings", "settings.web", "Settings", 
        "bi bi-person-square", "text-body"], 
    [],
    ["logout", "logout.web", "Logout", 
        "bi bi-door-closed", "text-danger"] 
]

var menu = fn(p, c, sess) {
    var ret = []
    var resource_user = []
    each(resource, fn(e, i) {
        if (is(e[2], "FUNCTION")) {
            set(e, 2, e[2](p, c, sess))
        }
        if (e[3] == null) {
            resource_user + e
        } else {
            if (empty(sess)) {
                if (e[3] == false) {
                    resource_user + e
                }
            } else {
                if (e[3] == true) {
                    resource_user + e
                }
            }
        }
    })
    ret + "
            <div class='sidebar-wrapper'>
                <nav class='mt-2'>
                    <ul class='
                            nav 
                            sidebar-menu 
                            flex-column' 
                        data-lte-toggle='treeview' 
                        role='menu' 
                        data-accordion='false'>
    "
    each(resource_user, fn(e, i) {
        var x = ""
        if (e[1] == p | e[0] == c) {
            var x = " active"
        }

        var f = e[2]
        var t = "<p class='
                        d-flex 
                        justify-content-between 
                        align-items-center 
                        w-100'>" + f[0] 
        var b = ""
        if ((!empty(string(f[1]))) & 
            (!empty(string(f[2])))) {
            var b = ("<span class='
                                ms-auto 
                                me-3 
                                nav-badge 
                                badge " + f[1] + "'>" +
                f[2] + "</span>")
        }
        var t = t + b 
        var o = ""
        var s = ""
        if (!empty(e[6])) {
            var t = t + "<i class='
                                nav-arrow 
                                bi 
                                bi-chevron-right'></i>"
            var o = ""
            if (e[7] == true) {
                var o = " menu-open"
            }
            var s = " bg-body-secondary"
        }

        var t = t + "</p>"

        
        ret + ("<li class='nav-item" + o + "'>")
        var m = (" 
            <a class='nav-link" + x + s +  
            "' href='" + e[1] + "'>" + 
                "<i class='nav-icon " + e[4] + "'></i>" + t  
            + "</a>")
        ret + m

        if (!empty(e[6])) {
            ret + "<ul class='nav nav-treeview'>"
            each(e[6], fn(ee, ii) {
                var ff = ee[1](p, c, sess, f)
                var tt = "<p class='ms-2 
                                d-flex 
                                justify-content-between 
                                align-items-center w-100'>" + 
                                ff[0] 
                var bb = ""
                if ((!empty(string(ff[1]))) & 
                    (!empty(string(ff[2])))) {
                    var bb = ("<span class='
                                        ms-auto 
                                        me-3 
                                        nav-badge 
                                        badge " + 
                                        ff[1] + "'>" +
                        ff[2] + "</span>")
                }
                var tt = tt + bb 
                var tt = tt + "</p>"
                ret + "<li class='nav-item'>"
                var mm = (" 
                    <a class='nav-link" + x + 
                    "' href='" + ee[0] + "'>" + 
                        "<i class='nav-icon " + 
                        ee[2] + "'></i>" + tt  
                    + "</a>")
                ret + mm
                ret + "</li>"
                
            })
            ret + "</ul>"
        }
        ret + "</li>"
    })
    ret + "
                    </ul>
                </nav>
            </div>
    "
    return join(newline(), ret)
}

var menu_account = fn(sess) {
    if (empty(sess)) {
        return ""
    }
    var ret = []
    ret + ("
            <ul class='navbar-nav ms-auto'>
                <li class='nav-item dropdown'>
                    <a class='nav-link' 
                        data-bs-toggle='dropdown' 
                        href='#' role='button'>
                        <i class='bi bi-person'>
                        </i>
                    </a>
                    <ul class='dropdown-menu 
                                dropdown-menu-end'>
                        
    ")
    each(resource_account, fn(e, i) {
        ret + "<li>"
        if (empty(e)) {
            ret + "<hr class='dropdown-divider'>"
        } else {
            ret + ("<a class='dropdown-item 
                                d-flex 
                                align-items-center " + 
                                e[4] + "' href='" + 
                                e[1] + "'>")
            ret + ("<i class='me-2 " + e[3] + "'></i>")
            ret + ("<span>" + e[2] + "</span>")
            ret + "</a>"
        }
        ret + "</li>"
    })
    ret + ("
                    </ul>
                </li>
            </ul>
    ")
    return join(newline(), ret)
}

