var b = runtime_command()["dir"] + "/data/"
var s = runtime_command()["dir"] + "/session/"
var f = b + "template.singkong"
var d = b + "password.html"

load_module("web")
var sess = session_file_get(s)
if ((sess["user"] == null) | (sess["session"] == null)) {
    redirect_to("login.web")
}

var t = "Change Password"
var p = "password.web"
var c = "password"

load(f)

if (request_method() == "GET") {
    cgi_header()
    var bc = [
    ]
    var tb = [
    ]
    var h = header(t, p, c, sess, bc, tb)
    println(h)
    println(template(read(d)))
    var h = footer(p)
    println(h)
    exit()
}

if (request_method() == "POST") {
    var regex_passwd = "^(?=.*[A-Z])(?=.*[a-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{6,}$"

    var f = cgi_post()
    var p = ifnull(f["p"], "")
    var n = ifnull(f["n"], "")
    var status = []
    if (matches(p, regex_passwd) != true) {
        status + "Invalid password"
    }
    if (matches(n, regex_passwd) != true) {
        status + "Invalid new password"
    }
    if (none(status)) {
        status + "OK"
    }

    var res = {
        "status": join(" ", status)
    }
    cgi_header({
        "Content-Type": "application/json"
    })
    println(json_string(res))
    exit()
}
